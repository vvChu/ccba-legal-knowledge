# System / IDE
.env
.vscode/
.idea/
*.log
*.bak

# Python / Node.js build
__pycache__/
*.pyc
node_modules/
.venv/
build/
dist/
*.egg-info/
requirements-hub.txt

# CCBA Agent Platform - Whitelist selected configs (skills is local only and git-ignored)
.agents/*
!.agents/workflows/
!.agents/workflows/*.bak
!.agents/proposals/
!.agents/AGENTS.md
.agents/**/*.log
.agents/**/*.json
.agents/**/*.env
.agents/**/__pycache__/
.agents/**/*.pyc

# Processing Workspace (.md/)
# Temp files during processing are ignored, but structure is tracked
.md/**/*.pdf
.md/**/*.docx
.md/**/*.xlsx
.md/**/*.pptx
.md/**/*.txt
!.md/**/raw_transcript.txt
.md/extracted_docs/*
!.md/extracted_docs/.gitkeep
.md/**/images/*.webp
.md/**/images/*.jpg
.md/**/images/*.png
scratch/
.md/scratch/


# Ignore all specific project outputs (OneDrive/SharePoint synced)
.md/projects/*
!.md/projects/.gitkeep
.md/data/chrome_cdp_profile/
.md/data/cache/
.md/data/telemetry_summary.json
.md/backups/

# ADR 0035 Tri-Tier Cloud Binary Vault (Stored on Google Drive)
legal_docs/**/sources/*.pdf
legal_docs/**/sources/*.docx
legal_docs/**/*.pdf
legal_docs/**/*.docx

# Caches and Scratch
.md/cache/formula_vision/
.md/cache/vision/
.md/data/chrome_vip_profile/
.md/data/legal_registry.yaml
.md/legal_docs/
.md/reports/*.html
.md/*.png

# Hub auto-generated editable links & Spoke Leakage Guard (ADR 0045)
.md/teach/
.md/data/*.json
.tmp/
.out-of-scope/
